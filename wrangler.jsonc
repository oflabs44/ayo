{
	"name": "ayo",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-18",
	"routes": [
		{
			"pattern": "ayo.oflabs.dev",
			"custom_domain": true,
		},
	],
	"observability": {
		"enabled": true,
	},
	"triggers": {
		"crons": ["* * * * *"],
	},
	"vars": {
		// Public origin of this Worker; the authority for every canonical link
		// Ayo hands out. Keep it in step with the route pattern above.
		"PUBLIC_BASE_URL": "https://ayo.oflabs.dev",
		// The account's default AI Gateway. A named gateway was tried in Jerry
		// and third-party models fail through it (credential resolution only
		// works via the default); re-test if the unified-billing surface changes.
		"AI_GATEWAY_ID": "default",
	},
	"ai": {
		"binding": "AI",
	},
	"vectorize": [
		{
			"binding": "VECTORIZE",
			"index_name": "ayo-search",
		},
	],
	"d1_databases": [
		{
			"binding": "JOBS_DB",
			"database_name": "ayo-jobs",
			"database_id": "bc2ca492-0d35-4645-bc47-e494e09a8452",
			"migrations_dir": "migrations",
		},
		{
			"binding": "LEDGER_DB",
			"database_name": "ayo-ledger",
			"database_id": "9740d9cc-20db-4ea0-a264-c20759c73acc",
			"migrations_dir": "migrations/ledger",
		},
	],
	"kv_namespaces": [
		{
			"binding": "OAUTH_KV",
			"id": "9e30aafde1184b51bccfe38c52a850ec",
		},
	],
	"worker_loaders": [
		{
			"binding": "LOADER",
		},
	],
	"services": [
		{
			"binding": "BUREAU",
			"service": "bureau",
			"entrypoint": "BureauRpc",
		},
		{
			"binding": "FILES",
			"service": "bureau-files",
			"entrypoint": "FilesRpc",
		},
		{
			"binding": "OCR",
			"service": "ocr",
			"entrypoint": "Ocr",
		},
		{
			"binding": "MAIL_READER",
			"service": "mycloud-mail",
			"entrypoint": "MailReader",
		},
		{
			"binding": "MAIL_WRITER",
			"service": "mycloud-mail",
			"entrypoint": "MailWriter",
		},
	],
}
