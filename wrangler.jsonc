{
	"name": "ayo",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-18",
	"routes": [
		{
			"pattern": "ayo.oflabs.dev",
			"custom_domain": true,
		},
	],
	"observability": {
		"enabled": true,
	},
	"ai": {
		"binding": "AI",
	},
	"vectorize": [
		{
			"binding": "VECTORIZE",
			"index_name": "ayo-search",
		},
	],
	"kv_namespaces": [
		{
			"binding": "OAUTH_KV",
			"id": "9e30aafde1184b51bccfe38c52a850ec",
		},
	],
	"worker_loaders": [
		{
			"binding": "LOADER",
		},
	],
	"services": [
		{
			"binding": "BUREAU",
			"service": "bureau",
			"entrypoint": "BureauRpc",
		},
	],
}
