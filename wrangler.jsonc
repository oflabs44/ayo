{
	"name": "ayo",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-18",
	"observability": {
		"enabled": true,
	},
	"ai": {
		"binding": "AI",
	},
	"vectorize": [
		{
			"binding": "VECTORIZE",
			"index_name": "ayo-search",
		},
	],
	"kv_namespaces": [
		{
			"binding": "OAUTH_KV",
			"id": "REPLACE_WITH_OAUTH_KV_NAMESPACE_ID",
		},
	],
}
